{
  "author": "Brandon Barker <brandon.barker@gmail.com> (https://github.com/bbarker)",
  "private": true,
  "scripts": {
    "build": "spago build --pedantic-packages --strict",
    "test": "NODE_OPTIONS='--import=./test/node.mjs' spago test --pedantic-packages",
    "testbrowser": "spago build --pedantic-packages && esbuild test/browser.js --bundle --outfile=dist/browser.js && node scripts/testbrowser.mjs",
    "lint": "oxlint --deny-warnings src test scripts",
    "format": "purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs' && oxfmt 'src/**/*.js' 'test/**/*.js' 'test/**/*.mjs' 'scripts/**/*.mjs'",
    "format:check": "purs-tidy check 'src/**/*.purs' 'test/**/*.purs' && oxfmt --check 'src/**/*.js' 'test/**/*.js' 'test/**/*.mjs' 'scripts/**/*.mjs'"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.0",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4"
  }
}
